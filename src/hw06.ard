-- 1. Определите функцию swap несколькими способами

-- При помощи \cowith и доступа к полям
\func swap {A B : \Type} (p : Pair A B) : Pair B A \cowith
  | fst_ => p.snd_
  | snd_ => p.fst_

-- При помощи \new и паттерн матчинга
\func swap' {A B : \Type} (p : Pair A B) : Pair B A =>
  \new Pair B A p.snd_ p.fst_

-- При помощи \new и доступа к полям
\func swap'' {A B : \Type} (p : Pair A B) : Pair B A =>
  \new Pair { | fst_ => p.snd_ | snd_ => p.fst_ }

-- 2. Докажите, что swap (swap p) = p

\func swap-involutive {A B : \Type} (p : Pair A B) : swap (swap p) = p => idp

-- 3. Докажите, что тип PosNat 0 пустой, а тип PosNat 1 нет

\func zero-isNotPos (p : PosNat 0) : Empty => p.p

\func one-isPos : PosNat 1 => \new PosNat 1 ()

-- 4. Определите \record, состоящий из пар взаимно простых натуральных чисел
--    Определите тип, состоящий из натуральных чисел, взаимно простых с 60

\record CoPrime (x y : Nat) (p : hw01.gcd x y = 1)

\func CoPrime60 : Nat -> \Type => CoPrime 60

-- 5. Закончите определение класса монад
--    Этот класс должен содержать все монадные законы и реализовывать все поля из класса функторов

\class Monad \extends Functor
  | return {A : \Type} : A -> F A
  | \infixl 2 >>= {A B : \Type} : F A -> (A -> F B) -> F B
  | left-id {A B : \Type} (a : A) (f : A -> F B) : return a >>= f = f a
  | right-id {A : \Type} (a : F A) : a >>= return = a
  | monad-assoc {A B C : \Type} (a : F A) (f : A -> F B) (g : B -> F C) : a >>= f >>= g = a >>= (\lam x => f x >>= g)

-- 6. Определите \instance Monad для Maybe

\instance MaybeMonad : Monad Maybe
  | return {A : \Type} : A -> Maybe A => just
  | fmap {A B : \Type} (f : A -> B) (xs : Maybe A) : Maybe B \elim xs {
    | nothing => nothing
    | just x => just (f x)
  }
  | fmap-id {A : \Type} (x : Maybe A) : fmap (\lam a => a) x = x \elim x {
    | nothing => idp
    | just x => idp
  }
  | fmap-comp {A B C : \Type} (f : B -> C) (g : A -> B) (x : Maybe A)
    : fmap (\lam a => f (g a)) x = fmap f (fmap g x) \elim x {
    | nothing => idp
    | just x => idp
  }
  | >>= {A B : \Type} : Maybe A -> (A -> Maybe B) -> Maybe B => \lam x f => \case x \with {
    | nothing => nothing
    | just x => f x
  }
  | left-id {A B : \Type} (a : A) (f : A -> Maybe B) : return a >>= f = f a => idp
  | right-id {A : \Type} (a : Maybe A) : a >>= return = a \elim a {
    | nothing => idp
    | just x => idp
  }
  | monad-assoc {A B C : \Type} (a : Maybe A) (f : A -> Maybe B) (g : B -> Maybe C)
    : a >>= f >>= g = a >>= (\lam x => f x >>= g) \elim a {
    | nothing => idp
    | just x => idp
  }

-- 7. Определите \instance Monad для State и State'

\record State (S A : \Type)
  | state : S -> \Sigma S A

\instance MonadState (S : \Type) : Monad (State S)
  | return {A : \Type} : A -> State S A => \lam x => \new State S A (\lam s => (s, x))
  | fmap {A B : \Type} (f : A -> B) (xs : State S A) : State S B =>
    \new State S B (\lam s => ((xs.state s).1, f (xs.state s).2))
  | fmap-id {A : \Type} (x : State S A) : fmap (\lam a => a) x = x => idp
  | fmap-comp {A B C : \Type} (f : B -> C) (g : A -> B) (x : State S A)
  : fmap (\lam a => f (g a)) x = fmap f (fmap g x) => idp
  | >>= {A B : \Type} : State S A -> (A -> State S B) -> State S B =>
    \lam a f =>
    \new State S B (\lam s => (f (a.state s).2).state (a.state s).1)
  | left-id {A B : \Type} (a : A) (f : A -> State S B) : return a >>= f = f a => idp
  | right-id {A : \Type} (a : State S A) : a >>= return = a => idp
  | monad-assoc {A B C : \Type} (a : State S A) (f : A -> State S B) (g : B -> State S C)
  : a >>= f >>= g = a >>= (\lam x => f x >>= g) => idp

\data State' (S A : \Type)
  | state' (S -> \Sigma S A)

\func apply {S A : \Type} (st : State' S A) (s : S): \Sigma S A \elim st
  | state' f => f s

\instance MonadState' (S : \Type) : Monad (State' S)
  | return {A : \Type} : A -> State' S A => \lam x => state' (\lam s => (s, x))
  | fmap {A B : \Type} (f : A -> B) (xs : State' S A) : State' S B \elim xs {
    | state' g => state' (\lam s => ((g s).1, f (g s).2))
  }
  | fmap-id {A : \Type} (x : State' S A) : fmap (\lam a => a) x = x \elim x {
    | state' f => idp
  }
  | fmap-comp {A B C : \Type} (f : B -> C) (g : A -> B) (x : State' S A)
    : fmap (\lam a => f (g a)) x = fmap f (fmap g x) \elim x {
    | state' f => idp
  }
  | >>= {A B : \Type} : State' S A -> (A -> State' S B) -> State' S B =>
    \lam a f => \case a \with {
      state' a => state' (\lam s => \case f (a s).2 \with {
        | state' r => r (a s).1
      })
    }
  | left-id {A B : \Type} (a : A) (f : A -> State' S B) : return a >>= f = f a => {?}
  | right-id {A : \Type} (a : State' S A) : a >>= return = a \elim a {
    | state' g => idp
  }
  | monad-assoc {A B C : \Type} (a : State' S A) (f : A -> State' S B) (g : B -> State' S C)
  : a >>= f >>= g = a >>= (\lam x => f x >>= g) => {?}
